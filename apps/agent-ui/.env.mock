VITE_MOCK_API=true
# Set to "true" to simulate an agent started in RVTools mode (no vCenter
# credentials/collector/inspector/storage-offload — upload-only flow).
VITE_MOCK_RVTOOLS_MODE=true
# Set to "false" to simulate a fresh appliance with no prior collection, so
# the login/upload screen renders on load instead of redirecting straight to
# /report. Defaults to "collected" (report-first) when unset.
VITE_MOCK_HAS_COLLECTION=false
